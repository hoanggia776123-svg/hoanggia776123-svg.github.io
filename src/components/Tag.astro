---
interface Props {
  tag: string;
  count?: number;
  active?: boolean;
  href?: string;
}

const { tag, count, active = false, href } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class={`inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono rounded-md border transition-all duration-200 ${
        active
          ? 'bg-cyan-500/20 text-cyan-300 border-cyan-400 shadow-[0_0_10px_rgba(0,242,254,0.3)]'
          : 'bg-cyber-900/60 text-slate-300 border-cyan-900/40 hover:border-cyan-400/60 hover:text-cyan-300 hover:bg-cyan-950/40'
      }`}
    >
      <span class="text-cyan-400/70">#</span>
      <span>{tag}</span>
      {count !== undefined && (
        <span class="ml-1 text-[10px] px-1.5 py-0.2 rounded-full bg-slate-800 text-slate-400">
          {count}
        </span>
      )}
    </a>
  ) : (
    <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-mono rounded border bg-cyber-900/50 text-slate-300 border-cyan-900/40">
      <span class="text-cyan-400/60">#</span>
      {tag}
    </span>
  )
}
