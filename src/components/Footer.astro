---
import { url } from '../utils/base';
import { Github, Terminal, Heart, ArrowUp } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-cyan-500/15 bg-cyber-950/70 backdrop-blur-md relative overflow-hidden">
  <!-- Glowing border line -->
  <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-cyan-500/50 to-transparent"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Bio -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <Terminal class="w-4 h-4 text-cyan-400" />
          <span class="font-mono text-sm font-semibold tracking-wider text-slate-100">
            [YOUR_NAME] // PORTFOLIO
          </span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          Phòng thí nghiệm cá nhân & portfolio công nghệ. Xây dựng với Astro, TypeScript và Tailwind CSS. Triển khai miễn phí trên GitHub Pages.
        </p>
        <div class="flex items-center gap-3 text-xs font-mono text-slate-400 pt-1">
          <span class="inline-flex items-center gap-1.5 text-emerald-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            SYS_STATUS: OPTIMAL
          </span>
          <span class="text-slate-600">|</span>
          <span>LATENCY: ~20ms</span>
          <span class="text-slate-600">|</span>
          <span>ASTRO v5</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="space-y-2">
        <h3 class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-wider">
          // Điều hướng
        </h3>
        <ul class="space-y-1.5 text-xs text-slate-400 font-mono">
          <li><a href={url('/')} class="hover:text-cyan-300 transition-colors">&gt; Home</a></li>
          <li><a href={url('/about/')} class="hover:text-cyan-300 transition-colors">&gt; About</a></li>
          <li><a href={url('/posts/')} class="hover:text-cyan-300 transition-colors">&gt; Posts / Blog</a></li>
          <li><a href={url('/projects/')} class="hover:text-cyan-300 transition-colors">&gt; Projects</a></li>
          <li><a href={url('/lab/')} class="hover:text-cyan-300 transition-colors">&gt; Lab Experiments</a></li>
          <li><a href={url('/contact/')} class="hover:text-cyan-300 transition-colors">&gt; Contact</a></li>
        </ul>
      </div>

      <!-- Col 3: External & Source -->
      <div class="space-y-2">
        <h3 class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-wider">
          // Liên kết
        </h3>
        <ul class="space-y-1.5 text-xs text-slate-400 font-mono">
          <li>
            <a
              href="https://github.com/hoanggia776123-svg"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-cyan-300 transition-colors inline-flex items-center gap-1"
            >
              <Github class="w-3.5 h-3.5" />
              <span>GitHub Profile</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/hoanggia776123-svg/hoanggia776123-svg.github.io"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-cyan-300 transition-colors"
            >
              Mã nguồn dự án
            </a>
          </li>
          <li>
            <a href={url('/robots.txt')} class="hover:text-cyan-300 transition-colors">
              Robots.txt
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
      <p>
        © {currentYear} [YOUR_NAME]. Tất cả các quyền được bảo lưu.
      </p>

      <button
        id="scroll-to-top"
        type="button"
        class="inline-flex items-center gap-1 px-3 py-1 rounded bg-cyber-900 border border-cyan-500/30 hover:border-cyan-400 hover:text-cyan-300 transition-all"
        aria-label="Cuộn lên đầu trang"
      >
        <ArrowUp class="w-3.5 h-3.5" />
        <span>TOP</span>
      </button>
    </div>
  </div>
</footer>

<script>
  function setupScrollTop() {
    const btn = document.getElementById('scroll-to-top');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
  setupScrollTop();
  document.addEventListener('astro:after-swap', setupScrollTop);
</script>
