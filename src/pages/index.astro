---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import LabCard from '../components/LabCard.astro';
import { url } from '../utils/base';
import { getCollection } from 'astro:content';
import {
  Terminal,
  ArrowRight,
  Cpu,
  Layers,
  BookOpen,
  FlaskConical,
  Mail,
  Sparkles,
  Code2,
  Database,
  Globe,
} from 'lucide-astro';

// Fetch collection items
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 3);

const allLabs = await getCollection('labs');
const featuredLabs = allLabs.filter((l) => l.data.featured).slice(0, 2);

const techStacks = [
  {
    category: 'Ngôn ngữ',
    icon: Code2,
    skills: ['TypeScript', 'JavaScript', 'Python', 'HTML/CSS', 'SQL'],
  },
  {
    category: 'Frontend & UI',
    icon: Globe,
    skills: ['Astro', 'Tailwind CSS', 'React', 'Next.js', 'Vite'],
  },
  {
    category: 'Backend & Data',
    icon: Database,
    skills: ['Node.js', 'FastAPI', 'Express', 'PostgreSQL', 'REST API'],
  },
  {
    category: 'AI & Công cụ',
    icon: Cpu,
    skills: ['Git', 'GitHub Actions', 'VS Code', 'LangChain', 'Docker'],
  },
];
---

<BaseLayout
  title="[YOUR_NAME] // Futuristic Tech Portfolio & AI Lab"
  description="Portfolio cá nhân phong cách Sci-Fi / AI Lab. Khám phá các dự án công nghệ, bài viết Markdown và các thử nghiệm tương tác."
>
  <!-- 1. HERO SECTION -->
  <section class="py-12 sm:py-20 relative">
    <div class="max-w-3xl">
      <!-- Status pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyber-900 border border-cyan-500/30 text-xs font-mono text-cyan-400 mb-6 shadow-[0_0_15px_rgba(0,242,254,0.15)]">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="text-slate-400">STATUS:</span>
        <span class="text-emerald-400 font-semibold">AVAILABLE FOR NEW OPPORTUNITIES</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-slate-100 mb-6 leading-tight">
        Xin chào, tôi là <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-500">
          [YOUR_NAME]
        </span>
      </h1>

      <!-- Role / Bio -->
      <p class="text-base sm:text-xl text-slate-300 font-light leading-relaxed mb-8">
        <span class="font-mono text-cyan-400 font-medium">[YOUR_ROLE]</span> &mdash; Đam mê nghiên cứu các hệ thống web tĩnh tốc độ cao, giao diện viễn tưởng và ứng dụng trí tuệ nhân tạo vào sản phẩm thực tế.
      </p>

      <!-- CTA Action Buttons -->
      <div class="flex flex-wrap items-center gap-4">
        <a
          href={url('/projects/')}
          class="px-6 py-3 rounded-lg font-mono text-xs font-semibold bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 hover:from-cyan-400 hover:to-blue-500 shadow-[0_0_20px_rgba(0,242,254,0.3)] transition-all flex items-center gap-2 group"
        >
          <span>Khám phá Dự án</span>
          <ArrowRight class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" />
        </a>

        <a
          href={url('/posts/')}
          class="px-6 py-3 rounded-lg font-mono text-xs font-semibold bg-cyber-900/90 text-slate-200 border border-cyan-500/30 hover:border-cyan-400 hover:text-cyan-300 hover:bg-cyber-850 transition-all flex items-center gap-2"
        >
          <BookOpen class="w-4 h-4 text-cyan-400" />
          <span>Đọc bài viết</span>
        </a>

        <a
          href={url('/contact/')}
          class="px-6 py-3 rounded-lg font-mono text-xs font-semibold text-slate-400 hover:text-slate-200 hover:bg-slate-900/50 transition-all"
        >
          Liên hệ &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- 2. TECH STACK SECTION -->
  <section class="py-12 border-t border-cyan-500/15">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-widest flex items-center gap-2">
          <Cpu class="w-4 h-4" />
          <span>// Hệ thống công nghệ & Kỹ năng</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">Các ngôn ngữ, framework và công cụ tôi đang sử dụng và nghiên cứu</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        techStacks.map((group) => {
          const Icon = group.icon;
          return (
            <div class="cyber-card p-5">
              <div class="flex items-center gap-2 text-cyan-400 font-mono text-xs font-semibold mb-3">
                <Icon class="w-4 h-4" />
                <span>{group.category}</span>
              </div>
              <ul class="space-y-1.5 text-xs text-slate-300 font-mono">
                {group.skills.map((skill) => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-500/50"></span>
                    <span>{skill}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- 3. FEATURED PROJECTS -->
  <section class="py-12 border-t border-cyan-500/15">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-widest flex items-center gap-2">
          <Layers class="w-4 h-4" />
          <span>// Dự án tiêu biểu</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">Các sản phẩm và đồ án cá nhân đã triển khai thực tế</p>
      </div>

      <a
        href={url('/projects/')}
        class="text-xs font-mono text-cyan-400 hover:text-cyan-300 inline-flex items-center gap-1 transition-colors"
      >
        <span>Xem tất cả ({allProjects.length})</span>
        <span>&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            date={project.data.date}
            techStack={project.data.techStack}
            demoUrl={project.data.demoUrl}
            repoUrl={project.data.repoUrl}
            status={project.data.status}
            slug={project.id}
            featured={project.data.featured}
          />
        ))
      }
    </div>
  </section>

  <!-- 4. LATEST POSTS -->
  <section class="py-12 border-t border-cyan-500/15">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-widest flex items-center gap-2">
          <BookOpen class="w-4 h-4" />
          <span>// Bài viết & Ghi chú kỹ thuật</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">Kiến thức và bài học kinh nghiệm được viết bằng Markdown</p>
      </div>

      <a
        href={url('/posts/')}
        class="text-xs font-mono text-cyan-400 hover:text-cyan-300 inline-flex items-center gap-1 transition-colors"
      >
        <span>Xem bài viết ({allPosts.length})</span>
        <span>&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        latestPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            category={post.data.category}
            slug={post.id}
            readingTime={post.data.readingTime}
          />
        ))
      }
    </div>
  </section>

  <!-- 5. LAB PREVIEW -->
  <section class="py-12 border-t border-cyan-500/15">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-widest flex items-center gap-2">
          <FlaskConical class="w-4 h-4" />
          <span>// Phòng thí nghiệm (Lab Preview)</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">Các ý tưởng thử nghiệm tương tác AI, Canvas và Web Graphics</p>
      </div>

      <a
        href={url('/lab/')}
        class="text-xs font-mono text-cyan-400 hover:text-cyan-300 inline-flex items-center gap-1 transition-colors"
      >
        <span>Vào phòng thí nghiệm</span>
        <span>&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        featuredLabs.map((lab) => (
          <LabCard
            title={lab.data.title}
            description={lab.data.description}
            category={lab.data.category}
            status={lab.data.status}
            tags={lab.data.tags}
            demoUrl={lab.data.demoUrl}
            repoUrl={lab.data.repoUrl}
            date={lab.data.date}
          />
        ))
      }
    </div>
  </section>

  <!-- 6. CONTACT CTA -->
  <section class="py-16 border-t border-cyan-500/15">
    <div class="cyber-card p-8 sm:p-12 text-center max-w-3xl mx-auto tech-corner">
      <div class="w-12 h-12 rounded-xl bg-cyan-950/80 border border-cyan-500/40 text-cyan-400 flex items-center justify-center mx-auto mb-6 shadow-[0_0_20px_rgba(0,242,254,0.3)]">
        <Mail class="w-6 h-6" />
      </div>

      <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-4">
        Bạn có ý tưởng dự án hoặc muốn trao đổi?
      </h2>

      <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto mb-8 leading-relaxed">
        Tôi luôn sẵn lòng kết nối, hợp tác thực hiện các dự án mã nguồn mở hoặc trao đổi về công nghệ, kiến trúc web tĩnh và AI.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href={url('/contact/')}
          class="px-6 py-3 rounded-lg font-mono text-xs font-semibold bg-cyan-400 text-slate-950 hover:bg-cyan-300 shadow-[0_0_20px_rgba(0,242,254,0.3)] transition-all"
        >
          Gửi tin nhắn liên hệ &rarr;
        </a>
        <a
          href="https://github.com/hoanggia776123-svg"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-lg font-mono text-xs font-semibold bg-cyber-900 border border-cyan-500/30 text-slate-300 hover:text-cyan-300 hover:border-cyan-400 transition-all"
        >
          Theo dõi trên GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
